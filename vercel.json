{
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/cleanup-expired",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-calendars",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/treatment-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/satisfaction-surveys",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/request-reviews",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/verify-doctor-credentials",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/gp-offer-expiry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expire-featured",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:locale(en|de|tr|fr|it|es|pt|zh|ja)/accept-terms",
      "destination": "/:locale/accept-terms"
    }
  ]
}
